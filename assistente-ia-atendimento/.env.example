# ──────────────────────────────────────────────────────────────────────────────
# Assistente IA para Atendimento — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o .env no Git!
# ──────────────────────────────────────────────────────────────────────────────

# ── Aplicação ──────────────────────────────────────────────────────────────────
APP_NAME="Assistente IA para Atendimento"
ENVIRONMENT=development        # development | staging | production
DEBUG=false
SHOW_DOCS=true                 # false em produção

# Gere uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua_chave_secreta_com_minimo_32_caracteres_aqui

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=atendimento
POSTGRES_PASSWORD=sua_senha_postgres_aqui
DATABASE_URL=postgresql+asyncpg://postgres:sua_senha_postgres_aqui@postgres:5432/atendimento

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── OpenAI ─────────────────────────────────────────────────────────────────────
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini      # gpt-4o para mais qualidade
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# System prompt padrão (pode ser sobrescrito por conversa)
AI_SYSTEM_PROMPT="Você é um assistente de atendimento profissional e prestativo. Responda de forma clara, objetiva e amigável. Se não souber a resposta, diga educadamente que irá verificar. Mantenha um tom profissional mas humano."

# ── WhatsApp Business API ──────────────────────────────────────────────────────
# Configure em: https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
# Token que você define — usado para verificar o webhook na Meta
WHATSAPP_VERIFY_TOKEN=meu_token_de_verificacao_unico

# ── Telegram ───────────────────────────────────────────────────────────────────
# Obtenha via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCDefghijklmnopqrstuvwxyz-XXXXXXXX

# ── Autenticação ───────────────────────────────────────────────────────────────
# Chave interna para autenticar chamadas da API (n8n, scripts, etc.)
# Gere: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=sua_chave_interna_de_api_aqui

# JWT para endpoints futuros (dashboard, etc.)
JWT_SECRET_KEY=sua_chave_jwt_secreta_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console             # console (dev) | json (produção)

# ── n8n ────────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678
N8N_USER=admin
N8N_PASSWORD=sua_senha_n8n_aqui

# ── pgAdmin (desenvolvimento) ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@seudominio.com
PGADMIN_PASSWORD=sua_senha_pgadmin_aqui

# ── Deploy em Cloud (opcional) ─────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# SENTRY_DSN=https://xxx@sentry.io/xxx
# DATADOG_API_KEY=
